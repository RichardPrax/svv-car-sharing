{
  "functions": {
    "src/pages/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "installCommand": "npm install && npm run postinstall",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/offline.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
